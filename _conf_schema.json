{
  "enabled": {
    "description": "启用私聊助手",
    "type": "bool",
    "hint": "关闭后本插件不处理任何私聊",
    "default": true
  },
  "owner_qq": {
    "description": "主人 QQ（可选）",
    "type": "string",
    "hint": "留空则对所有私聊好友生效；填了则只服务该 QQ",
    "default": "407171301"
  },
  "link_summarize": {
    "description": "链接摘要",
    "type": "object",
    "hint": "",
    "items": {
      "enabled": {
        "description": "启用链接摘要",
        "type": "bool",
        "default": true
      },
      "provider_id": {
        "description": "摘要用的 LLM 提供商",
        "hint": "空则用当前会话默认 LLM",
        "type": "string",
        "default": "",
        "_special": "select_provider"
      },
      "system_prompt": {
        "description": "摘要人设提示词",
        "type": "text",
        "default": "你是大肥鱼，说话短、软、口语化，像朋友私聊。用户发来 B站或小红书链接时，根据提供的标题/简介写一段 2～4 句的短摘要，带一点你的吐槽或情绪，不要机械复述，不要用 markdown，不要说「作为AI」。"
      }
    }
  },
  "image": {
    "description": "搜图/生图",
    "type": "object",
    "hint": "",
    "items": {
      "enabled": {
        "description": "启用看图能力",
        "type": "bool",
        "default": true
      },
      "prefer_search": {
        "description": "优先搜图，失败再生图",
        "type": "bool",
        "default": true
      },
      "max_bytes": {
        "description": "下发图片最大字节",
        "type": "int",
        "default": 1048576
      },
      "gen_backend": {
        "description": "生图后端",
        "hint": "none=不生图只搜；ollama=调用 Ollama 图像模型（需已拉取）；stub=仅提示未配置",
        "type": "string",
        "default": "stub"
      },
      "ollama_base": {
        "description": "Ollama 地址",
        "type": "string",
        "default": "http://127.0.0.1:11434"
      },
      "ollama_model": {
        "description": "Ollama 生图模型名",
        "hint": "例如 sd / flux；当前机器若只有 bge-m3 会自动降级",
        "type": "string",
        "default": ""
      },
      "caption_with_llm": {
        "description": "发图时附一句口语配文",
        "type": "bool",
        "default": true
      }
    }
  },
  "cache_root": {
    "description": "缓存目录（可改，默认便于 D 盘部署）",
    "type": "string",
    "default": "D:\\AstrBot\\chat_cache",
    "hint": "临时图片目录。默认 D:\\\\AstrBot\\\\chat_cache；也可设环境变量 DAFEIYU_CHAT_CACHE。其他人请改成自己的可写路径。"
  }
}
